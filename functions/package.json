{
  "name": "prepnotes-functions",
  "description": "PrepNotes Cloud Functions (TypeScript, 2nd gen)",
  "private": true,
  "main": "lib/index.js",
  "engines": {
    "node": "22"
  },
  "scripts": {
    "build": "tsc",
    "build:watch": "tsc --watch",
    "lint": "eslint src test",
    "serve": "npm run build && firebase emulators:start --only functions",
    "logs": "firebase functions:log",
    "test:rules": "vitest run test/rules",
    "rules:test": "firebase emulators:exec --only firestore,storage \"npm run test:rules\""
  },
  "dependencies": {
    "firebase-admin": "^14.5.0",
    "firebase-functions": "^7.4.0"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@firebase/rules-unit-testing": "^5.0.2",
    "eslint": "^10.12.0",
    "firebase": "^12.19.0",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.71.0",
    "vitest": "^5.0.3"
  }
}
