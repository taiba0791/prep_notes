rules_version = '2';

// PrepNotes Firestore security rules.
// Anything not explicitly allowed below is DENIED.
// Field names must match lib/core/constants/firestore_paths.dart.
// Tests: functions/test/rules/*.test.ts  (npm --prefix functions run rules:test)
service cloud.firestore {
  match /databases/{database}/documents {

    // ───────────────────────── Helpers ─────────────────────────

    function signedIn() {
      return request.auth != null;
    }

    // Admin = custom claim set ONLY by a Cloud Function (setAdminClaim).
    function isAdmin() {
      return signedIn() && request.auth.token.get('admin', false) == true;
    }

    function isOwner(uid) {
      return signedIn() && request.auth.uid == uid;
    }

    // Optional string field: absent, or a string of at most `max` chars.
    function optionalString(data, field, max) {
      return !(field in data) || (data[field] is string && data[field].size() <= max);
    }

    // Resource Room open? users/{uid}.roomAccessUntil is set ONLY by Cloud
    // Functions (latest end of an active semester bundle / Room subscription).
    function roomOpen(uid) {
      let until = get(/databases/$(database)/documents/users/$(uid)).data
        .get('roomAccessUntil', null);
      return until != null && until > request.time;
    }

    // ───────────────────────── users ─────────────────────────

    match /users/{uid} {
      allow get: if isOwner(uid) || isAdmin();
      allow list: if isAdmin();
      allow create: if isOwner(uid) && isValidNewProfile();
      allow update: if isOwner(uid) && isValidProfileUpdate();
      // Account deletion is done by a Cloud Function (Admin SDK).
      allow delete: if false;

      function isValidName(name) {
        return name is string && name.size() >= 2 && name.size() <= 60;
      }

      function isValidSemester(data) {
        return !('semester' in data)
          || (data.semester is int && data.semester >= 1 && data.semester <= 10);
      }

      function hasValidOptionalFields(data) {
        return optionalString(data, 'photoUrl', 1024)
          && optionalString(data, 'universityId', 128)
          && isValidSemester(data);
      }

      // New profile: only known fields; a plain student with 0 minutes;
      // email = the signed-in email; timestamps from the server clock.
      function isValidNewProfile() {
        let d = request.resource.data;
        return d.keys().hasOnly([
            'name', 'email', 'photoUrl', 'universityId', 'semester',
            'role', 'totalStudyMinutes', 'createdAt', 'lastLoginAt'])
          && d.keys().hasAll(['name', 'email', 'role', 'totalStudyMinutes', 'createdAt'])
          && isValidName(d.name)
          && d.email == request.auth.token.email
          && d.role == 'student'
          && d.totalStudyMinutes == 0
          && d.createdAt == request.time
          && (!('lastLoginAt' in d) || d.lastLoginAt == request.time)
          && hasValidOptionalFields(d);
      }

      // Update: only editable fields may change. role, email, createdAt and
      // totalStudyMinutes are locked (study minutes → Cloud Function, Phase 8).
      function isValidProfileUpdate() {
        let d = request.resource.data;
        let changed = d.diff(resource.data).affectedKeys();
        return changed.hasOnly(['name', 'photoUrl', 'universityId', 'semester', 'lastLoginAt'])
          && isValidName(d.name)
          && hasValidOptionalFields(d)
          && (!('lastLoginAt' in changed) || d.lastLoginAt == request.time);
      }

      // Purchases: written ONLY by Cloud Functions after payment (Phase 4).
      match /entitlements/{noteId} {
        allow read: if isOwner(uid) || isAdmin();
        allow write: if false;
      }

      // Semester bundles: written ONLY by Cloud Functions after payment.
      match /bundles/{semesterId} {
        allow read: if isOwner(uid) || isAdmin();
        allow write: if false;
      }

      // Resource Room: the student's private locker (Drive / YouTube links
      // and their own files). Only while their Room access is active.
      match /roomItems/{itemId} {
        allow read: if isOwner(uid) && roomOpen(uid);
        allow delete: if isOwner(uid);
        allow create: if isOwner(uid) && roomOpen(uid) && isValidRoomItem(itemId);
        allow update: if isOwner(uid) && roomOpen(uid)
          && request.resource.data.diff(resource.data).affectedKeys()
               .hasOnly(['title', 'searchKeywords'])
          && isText(request.resource.data.title, 1, 200)
          && request.resource.data.searchKeywords is list
          && request.resource.data.searchKeywords.size() <= 100;
      }

      function isValidRoomItem(itemId) {
        let d = request.resource.data;
        return d.keys().hasOnly([
            'type', 'title', 'url', 'storagePath', 'fileName', 'contentType',
            'sizeBytes', 'createdAt', 'searchKeywords'])
          && isText(d.title, 1, 200)
          && d.createdAt == request.time
          && d.searchKeywords is list && d.searchKeywords.size() <= 100
          && ((d.type in ['drive', 'youtube']
                && isText(d.url, 10, 2000)
                && (d.type != 'drive'
                    || d.url.matches('^https://(drive|docs)[.]google[.]com/.*'))
                && (d.type != 'youtube'
                    || d.url.matches('^https://(www[.]|m[.])?(youtube[.]com|youtu[.]be)/.*'))
                && !('storagePath' in d))
              || (d.type == 'file'
                && isText(d.fileName, 1, 200)
                && d.storagePath == 'room/' + uid + '/' + itemId + '/' + d.fileName
                && d.contentType in ['application/pdf', 'image/jpeg', 'image/png', 'image/webp']
                && d.sizeBytes is int && d.sizeBytes > 0 && d.sizeBytes <= 26214400
                && !('url' in d)));
      }

      // "Recently viewed": the owner keeps a small copy of notes they opened
      // (the app trims it to the newest 20).
      match /recentlyViewed/{noteId} {
        allow read, delete: if isOwner(uid);
        allow create, update: if isOwner(uid)
          && request.resource.data.keys().hasOnly([
               'noteId', 'title', 'universityName', 'semesterNumber', 'subjectName',
               'price', 'isFree', 'thumbnailUrl', 'pageCount', 'viewedAt'])
          && request.resource.data.noteId == noteId
          && request.resource.data.title is string
          && request.resource.data.title.size() <= 200
          && request.resource.data.price is int
          && request.resource.data.viewedAt == request.time;
      }
    }

    // ───────────────────────── orders ─────────────────────────
    // Created and updated ONLY by Cloud Functions (createOrder, verifyPayment,
    // razorpayWebhook). Students read their own; list queries must filter
    // on userId == their uid.

    match /orders/{orderId} {
      allow read: if isAdmin()
        || (signedIn() && resource.data.userId == request.auth.uid);
      allow write: if false;
    }

    // ───────────────────────── stats ─────────────────────────
    // Dashboard counters, maintained by Cloud Functions; admins read them.

    match /stats/{statId} {
      allow read: if isAdmin();
      allow write: if false;
    }

    match /stats_daily/{day} {
      allow read: if isAdmin();
      allow write: if false;
    }

    // ─────────────────── Room subscriptions + plans ───────────────────

    match /subscriptions/{subscriptionId} {
      allow read: if isAdmin()
        || (signedIn() && resource.data.userId == request.auth.uid);
      allow write: if false;
    }

    // Public settings, e.g. config/roomPlans (prices). Written by Functions.
    match /config/{docId} {
      allow read: if true;
      allow write: if false;
    }

    // fileAccessLogs, rateLimits: server-only (no match = denied).

    // ───────────────────────── catalog ─────────────────────────
    // University → Semester → Subject → Module: anyone can read (it's the
    // public catalog); only admins write, with field checks.

    function isText(v, min, max) {
      return v is string && v.size() >= min && v.size() <= max;
    }

    function optionalText(d, field, max) {
      return !(field in d) || isText(d[field], 0, max);
    }

    match /universities/{universityId} {
      allow read: if true;
      allow create, update: if isAdmin()
        && request.resource.data.keys().hasOnly([
             'name', 'shortName', 'city', 'logoUrl', 'description', 'isActive', 'order'])
        && isText(request.resource.data.name, 2, 120)
        && optionalText(request.resource.data, 'shortName', 20)
        && optionalText(request.resource.data, 'city', 80)
        && optionalText(request.resource.data, 'logoUrl', 1024)
        && optionalText(request.resource.data, 'description', 1000)
        && request.resource.data.isActive is bool
        && request.resource.data.order is int;
      allow delete: if isAdmin();
    }

    match /semesters/{semesterId} {
      allow read: if true;
      allow create, update: if isAdmin()
        && request.resource.data.keys().hasOnly(['universityId', 'number', 'name', 'isActive', 'bundlePrice'])
        // Semester bundle price in paise (₹1 – ₹1,00,000); missing = ₹899.
        && (!('bundlePrice' in request.resource.data)
            || (request.resource.data.bundlePrice is int
                && request.resource.data.bundlePrice >= 100
                && request.resource.data.bundlePrice <= 10000000))
        && isText(request.resource.data.universityId, 1, 128)
        && request.resource.data.number is int
        && request.resource.data.number >= 1 && request.resource.data.number <= 12
        && isText(request.resource.data.name, 1, 60)
        && request.resource.data.isActive is bool;
      allow delete: if isAdmin();
    }

    match /subjects/{subjectId} {
      allow read: if true;
      allow create, update: if isAdmin()
        && request.resource.data.keys().hasOnly([
             'universityId', 'semesterId', 'name', 'code', 'description', 'isActive'])
        && isText(request.resource.data.universityId, 1, 128)
        && isText(request.resource.data.semesterId, 1, 128)
        && isText(request.resource.data.name, 2, 120)
        && optionalText(request.resource.data, 'code', 30)
        && optionalText(request.resource.data, 'description', 1000)
        && request.resource.data.isActive is bool;
      allow delete: if isAdmin();
    }

    match /modules/{moduleId} {
      allow read: if true;
      allow create, update: if isAdmin()
        && request.resource.data.keys().hasOnly(['subjectId', 'number', 'title', 'isActive'])
        && isText(request.resource.data.subjectId, 1, 128)
        && request.resource.data.number is int
        && request.resource.data.number >= 1 && request.resource.data.number <= 50
        && isText(request.resource.data.title, 1, 160)
        && request.resource.data.isActive is bool;
      allow delete: if isAdmin();
    }

    // ───────────────────────── notes ─────────────────────────
    // Students see only PUBLISHED notes (their queries must filter on
    // isPublished == true). Admins see and write everything.
    // pageCount / fileSizeBytes / hasPreview / purchaseCount are written only
    // by Cloud Functions; admins can't change them from the app.

    match /notes/{noteId} {
      allow read: if resource.data.isPublished == true || isAdmin();
      allow create: if isAdmin()
        && isValidNote(request.resource.data)
        && request.resource.data.pageCount == 0
        && request.resource.data.fileSizeBytes == 0
        && request.resource.data.hasPreview == false
        && request.resource.data.purchaseCount == 0
        && request.resource.data.createdAt == request.time
        && request.resource.data.updatedAt == request.time;
      allow update: if isAdmin()
        && isValidNote(request.resource.data)
        && !request.resource.data.diff(resource.data).affectedKeys().hasAny([
             'pageCount', 'fileSizeBytes', 'hasPreview', 'purchaseCount', 'createdAt'])
        && request.resource.data.updatedAt == request.time;
      allow delete: if isAdmin();

      function isValidNote(d) {
        return d.keys().hasOnly([
            'title', 'description', 'universityId', 'semesterId', 'subjectId', 'moduleId',
            'universityName', 'semesterNumber', 'subjectName', 'moduleTitle',
            'price', 'isFree', 'thumbnailUrl', 'pageCount', 'fileSizeBytes',
            'storagePath', 'previewPages', 'hasPreview', 'isPublished', 'isFeatured', 'purchaseCount',
            'tags', 'searchKeywords', 'createdAt', 'updatedAt'])
          && isText(d.title, 3, 200)
          && optionalText(d, 'description', 5000)
          && isText(d.universityId, 1, 128) && isText(d.semesterId, 1, 128)
          && isText(d.subjectId, 1, 128) && isText(d.moduleId, 1, 128)
          // Money in paise: whole number, ₹0 – ₹1,00,000.
          && d.price is int && d.price >= 0 && d.price <= 10000000
          && d.isFree is bool
          && (d.isFree || d.price > 0)
          && d.previewPages is int && d.previewPages >= 0 && d.previewPages <= 30
          && d.isPublished is bool
          && (!('isFeatured' in d) || d.isFeatured is bool)
          // Can't publish without a PDF.
          && (!d.isPublished || ('storagePath' in d && d.storagePath == 'notes_private/' + noteId + '/file.pdf'))
          && optionalText(d, 'thumbnailUrl', 1024)
          && d.tags is list && d.tags.size() <= 20
          && d.searchKeywords is list && d.searchKeywords.size() <= 300;
      }
    }
  }
}
