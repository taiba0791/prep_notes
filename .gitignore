#.vscode/

# Flutter/Dart/Pub related
**/doc/api/
**/ios/Flutter/.last_build_id
.dart_tool/
.flutter-plugins-dependencies
.pub-cache/
.pub/
/build/
/coverage/

# Symbolication related
app.*.symbols

# Obfuscation related
app.*.map.json

# Android Studio will place build artifacts here
/android/app/debug
/android/app/profile
/android/app/release

# Generated code (re-create with: dart run build_runner build)
*.g.dart
*.freezed.dart

# Firebase CLI / emulator files
.firebase/
firebase-debug.log*
firestore-debug.log*
ui-debug.log*
database-debug.log*
pubsub-debug.log*
emulator-data/

# ── Secrets: NEVER commit these ──────────────────────────────────────
# Environment files (keep a committed .env.example with dummy values)
.env
.env.*
!.env.example
*.local
# Google service-account keys / Admin SDK credentials
service-account*.json
*-service-account.json
*firebase-adminsdk*.json
# Android release signing
*.jks
*.keystore
android/key.properties
# iOS signing
*.p12
*.mobileprovision
*.p8
# Razorpay and other private keys
*.pem
*.key
secrets/
